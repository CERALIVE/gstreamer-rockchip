# The Rockchip MPP / RGA build+ABI contract, in ONE place.
#
# `libgstrockchipmpp.so` is only as correct as the MPP it was compiled against:
# the plugin calls into librockchip_mpp, and a header/runtime mismatch surfaces
# on a board as an element that loads and then fails at the first `mpp_*` call.
# So the CI build installs EXACTLY the MPP the device image installs, pinned by
# URL and SHA-256, and check-mpp-abi.sh re-derives the plugin's undefined-symbol
# closure against that same pinned runtime.
#
# MPP_RUNTIME_URL/SHA256 are copied verbatim from the device image's own pin:
#   image-building-pipeline/manifests/rk3588-userspace-deb-versions.txt
# Never bump one without the other — the whole value of this file is that the
# library CI proves against is byte-identical to the library the board runs.
#
# The -dev package is the matching headers + `rockchip_mpp.pc` from the SAME
# upstream release; librga-dev is the ABI-matched 2D accelerator the shipped
# radxa plugin also links (debian/rules builds with -Drga=enabled).

MPP_RELEASE_BASE=https://github.com/tsukumijima/mpp-rockchip/releases/download/v1.5.0-1-20250110-194af18

MPP_RUNTIME_DEB=librockchip-mpp1_1.5.0-1_arm64.deb
MPP_RUNTIME_URL=${MPP_RELEASE_BASE}/librockchip-mpp1_1.5.0-1_arm64.deb
MPP_RUNTIME_SHA256=fe839d41010def25b2c096581815fd26214680bf9720fc47ff2c7afe501f6bcd

MPP_DEV_DEB=librockchip-mpp-dev_1.5.0-1_arm64.deb
MPP_DEV_URL=${MPP_RELEASE_BASE}/librockchip-mpp-dev_1.5.0-1_arm64.deb
MPP_DEV_SHA256=aa38d6476ff4798623b37f09845436ab80d730f42c17e305f43ba7a892ee34fe

RGA_DEV_DEB=librga-dev_2.2.0-1_arm64.deb
RGA_DEV_URL=https://radxa-repo.github.io/rk3588s2-bookworm/pool/main/libr/librga/librga-dev_2.2.0-1_arm64.deb
RGA_DEV_SHA256=49885e2423bff2cdcfd319c0e76259e46d6d13e3d26c057cf988653600a4043d

RGA_RUNTIME_DEB=librga2_2.2.0-1_arm64.deb
RGA_RUNTIME_URL=https://radxa-repo.github.io/rk3588s2-bookworm/pool/main/libr/librga/librga2_2.2.0-1_arm64.deb
RGA_RUNTIME_SHA256=ca4f18666f6c5d5290c7e41e5901350ecf76530f24364e37b81fa6be4ab5f344

# The SONAME check-mpp-abi.sh resolves the plugin's MPP-only symbols against.
MPP_SONAME=librockchip_mpp.so.1
